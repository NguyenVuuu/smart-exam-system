{
  "expo": {
    "name": "soes-mobile",
    "slug": "soes-mobile",
    "scheme": "soes-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.btphat11321.soesmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "@blacktomang/expo-aws-liveness",
        {
          "cameraPermission": "SOES cần dùng camera để đăng ký khuôn mặt sinh viên."
        }
      ],
      "./plugins/withFaceLivenessIosRegistration",
      "./plugins/withLiteRtNamespaceWorkaround"
    ],
    "extra": {
      "eas": {
        "projectId": "d7afd2a6-a720-4b13-bfe4-c0b3aadf6633"
      }
    }
  }
}
