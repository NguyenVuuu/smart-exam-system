# Điện thoại thật: thay YOUR_LAN_IP bằng IPv4 Wi-Fi của máy chạy backend.
# Android Emulator có thể dùng http://10.0.2.2:3000/api.
# Web có thể dùng http://localhost:3000/api.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:3000/api
# Cognito Identity Pool cho AWS Face Liveness. Đây là ID công khai, không phải access key.
EXPO_PUBLIC_AWS_FACE_IDENTITY_POOL_ID=ap-northeast-1:YOUR_IDENTITY_POOL_ID
