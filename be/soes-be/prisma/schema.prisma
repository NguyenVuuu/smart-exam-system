generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String?
  phoneNumber   String?
  fullName      String
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  admin         Admin?
  auditLogs     AuditLog[]
  notifications Notification[]
  student       Student?
  teacher       Teacher?
}

model Student {
  id           String        @id @default(uuid())
  studentCode  String        @unique
  password     String
  status       AccountStatus @default(ACTIVE)
  userId       String        @unique
  enrollments  Enrollment[]  @relation("StudentEnrollments")
  examAttempts ExamAttempt[] @relation("StudentExamAttempts")
  user         User          @relation(fields: [userId], references: [id])
}

model Teacher {
  id                  String                @id @default(uuid())
  teacherCode         String                @unique
  password            String
  status              AccountStatus         @default(ACTIVE)
  position            TeacherPosition       @default(LECTURER)
  departmentId        String?
  userId              String                @unique
  courseOfferings     CourseOffering[]      @relation("TeacherCourseOfferings")
  exams               Exam[]                @relation("CreatorExams")
  posts               Post[]                @relation("TeacherPosts")
  materials           Material[]            @relation("UploaderMaterials")
  questions           Question[]            @relation("OwnerQuestions")
  aiGenerations       AIGenerationHistory[]
  questionBankReviews QuestionBankItem[]    @relation("QuestionBankTeacherReviews")
  examReviews         Exam[]                @relation("TeacherExamReviews")
  department          Department?           @relation("DepartmentTeachers", fields: [departmentId], references: [id])
  user                User                  @relation(fields: [userId], references: [id])

  @@index([departmentId])
  @@index([position])
}

model Admin {
  id                  String             @id @default(uuid())
  adminCode           String             @unique
  password            String
  status              AccountStatus      @default(ACTIVE)
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id])
  questionBankReviews QuestionBankItem[] @relation("QuestionBankReviews")
}

model Department {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  teachers    Teacher[]        @relation("DepartmentTeachers")
  subjects    Subject[]        @relation("DepartmentSubjects")
}

model CodeGenerationSetting {
  id            String   @id @default("SYSTEM")
  studentPrefix String   @default("SV")
  studentDigits Int      @default(6)
  teacherPrefix String   @default("GV")
  teacherDigits Int      @default(6)
  adminPrefix   String   @default("AD")
  adminDigits   Int      @default(6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Semester {
  id              String           @id @default(uuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  status          SemesterStatus   @default(UPCOMING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  courseOfferings CourseOffering[]
}

model Subject {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  status          SubjectStatus    @default(ACTIVE)
  departmentId    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  courseOfferings CourseOffering[]
  questions       Question[]
  questionBank    QuestionBank?
  department      Department?      @relation("DepartmentSubjects", fields: [departmentId], references: [id])

  @@index([departmentId])
}

model CourseOffering {
  id            String                @id @default(uuid())
  code          String                @unique
  status        CourseOfferingStatus  @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  semesterId    String
  subjectId     String
  teacherId     String
  semester      Semester              @relation(fields: [semesterId], references: [id])
  subject       Subject               @relation(fields: [subjectId], references: [id])
  teacher       Teacher               @relation("TeacherCourseOfferings", fields: [teacherId], references: [id])
  enrollments   Enrollment[]
  exams         Exam[]
  materials     Material[]
  posts         Post[]
  aiGenerations AIGenerationHistory[]

  @@index([teacherId])
  @@index([semesterId])
  @@index([subjectId])
}

model Enrollment {
  id               String         @id @default(uuid())
  enrolledAt       DateTime       @default(now())
  courseOfferingId String
  studentId        String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id])
  student          Student        @relation("StudentEnrollments", fields: [studentId], references: [id])

  @@unique([courseOfferingId, studentId])
  @@index([studentId])
}

model Post {
  id               String           @id @default(uuid())
  title            String
  content          String
  status           PostStatus       @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  publishedAt      DateTime?
  courseOfferingId String
  createdById      String
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  createdBy        Teacher          @relation("TeacherPosts", fields: [createdById], references: [id])
  attachments      PostAttachment[]

  @@index([createdById])
  @@index([courseOfferingId, publishedAt])
}

model PostAttachment {
  id          String   @id @default(uuid())
  fileName    String
  objectName  String
  fileSize    Int
  contentType String
  storagePath String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  postId      String
  post        Post     @relation(fields: [postId], references: [id])

  @@unique([postId, fileName])
  @@index([postId])
}

model Material {
  id               String                 @id @default(uuid())
  fileName         String
  objectName       String
  fileSize         Int
  contentType      String
  storagePath      String
  aiEnabled        Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  courseOfferingId String
  uploaderId       String
  courseOffering   CourseOffering         @relation(fields: [courseOfferingId], references: [id])
  uploader         Teacher                @relation("UploaderMaterials", fields: [uploaderId], references: [id])
  aiGenerations    AIGenerationMaterial[]

  @@unique([courseOfferingId, fileName])
  @@index([courseOfferingId])
  @@index([uploaderId])
}

model QuestionBank {
  id        String             @id @default(uuid())
  subjectId String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  subject   Subject            @relation(fields: [subjectId], references: [id])
  items     QuestionBankItem[]

  @@index([subjectId])
}

model QuestionBankItem {
  id                  String                 @id @default(uuid())
  questionBankId      String
  questionId          String                 @unique
  status              QuestionBankItemStatus @default(PENDING)
  reviewedAt          DateTime?
  reviewedById        String?
  reviewedByTeacherId String?
  rejectionReason     String?
  addedAt             DateTime               @default(now())
  removedAt           DateTime? // Soft-delete khỏi bank, Question vẫn tồn tại
  reviewedBy          Admin?                 @relation("QuestionBankReviews", fields: [reviewedById], references: [id])
  reviewedByTeacher   Teacher?               @relation("QuestionBankTeacherReviews", fields: [reviewedByTeacherId], references: [id])
  questionBank        QuestionBank           @relation(fields: [questionBankId], references: [id])
  question            Question               @relation(fields: [questionId], references: [id])

  @@index([questionBankId, status, removedAt])
  @@index([reviewedByTeacherId])
}

model Question {
  id               String               @id @default(uuid())
  content          String
  explanation      String?
  type             QuestionType
  difficulty       QuestionDifficulty
  source           QuestionSource
  language         ProgrammingLanguage?
  aiReviewStatus   AIReviewStatus? // BR-12A: Giảng viên review câu AI
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ownerId          String
  subjectId        String
  aiGenerationId   String?
  owner            Teacher              @relation("OwnerQuestions", fields: [ownerId], references: [id])
  subject          Subject              @relation(fields: [subjectId], references: [id])
  aiGeneration     AIGenerationHistory? @relation(fields: [aiGenerationId], references: [id])
  examQuestions    ExamQuestion[]       @relation("ExamQuestionSource")
  questionBankItem QuestionBankItem?
  options          QuestionOption[]

  @@index([ownerId])
  @@index([subjectId])
  @@index([type])
  @@index([aiGenerationId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model AIGenerationHistory {
  id               String                 @id @default(uuid())
  teacherId        String
  courseOfferingId String
  prompt           String
  aiModel          String
  questionCount    Int
  status           AIGenerationStatus     @default(PENDING)
  createdAt        DateTime               @default(now())
  completedAt      DateTime?
  teacher          Teacher                @relation(fields: [teacherId], references: [id])
  courseOffering   CourseOffering         @relation(fields: [courseOfferingId], references: [id])
  materials        AIGenerationMaterial[]
  questions        Question[]

  @@index([teacherId])
  @@index([courseOfferingId])
}

model AIGenerationMaterial {
  id         String              @id @default(uuid())
  historyId  String
  materialId String
  history    AIGenerationHistory @relation(fields: [historyId], references: [id])
  material   Material            @relation(fields: [materialId], references: [id])

  @@unique([historyId, materialId])
  @@index([historyId])
  @@index([materialId])
}

model Exam {
  id                      String             @id @default(uuid())
  title                   String
  description             String?
  password                String?
  startTime               DateTime
  endTime                 DateTime
  durationMinutes         Int
  maxAttempts             Int                @default(1)
  shuffleQuestions        Boolean            @default(false)
  shuffleOptions          Boolean            @default(false)
  showResultImmediately   Boolean            @default(false)
  allowReviewBeforeSubmit Boolean            @default(false)
  resultPublished         Boolean            @default(false)
  resultPublishedAt       DateTime?
  status                  ExamStatus         @default(DRAFT)
  approvalStatus          ExamApprovalStatus @default(NOT_REQUIRED)
  reviewedAt              DateTime?
  reviewedById            String?
  rejectionReason         String?
  creationMethod          ExamCreationMethod @default(MANUAL)
  type                    ExamType           @default(QUIZ)
  requireFullscreen       Boolean            @default(false)
  enableWebcam            Boolean            @default(false)
  blockCopyPaste          Boolean            @default(true)
  blockRightClick         Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  publishedAt             DateTime?
  courseOfferingId        String
  createdById             String
  courseOffering          CourseOffering     @relation(fields: [courseOfferingId], references: [id])
  createdBy               Teacher            @relation("CreatorExams", fields: [createdById], references: [id])
  reviewedBy              Teacher?           @relation("TeacherExamReviews", fields: [reviewedById], references: [id])
  examAttempts            ExamAttempt[]
  examQuestions           ExamQuestion[]

  @@index([courseOfferingId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([status])
  @@index([approvalStatus])
}

model ExamQuestion {
  id         String  @id @default(uuid())
  orderIndex Int
  points     Decimal @db.Decimal(5, 2)

  // Snapshot của Question tại thời điểm thêm vào Exam
  content                String
  explanation            String?
  type                   QuestionType
  difficulty             QuestionDifficulty
  language               ProgrammingLanguage?
  sourceQuestionId       String?
  examId                 String
  exam                   Exam                       @relation(fields: [examId], references: [id])
  sourceQuestion         Question?                  @relation("ExamQuestionSource", fields: [sourceQuestionId], references: [id])
  options                ExamQuestionOption[]
  attemptQuestions       ExamAttemptQuestion[]
  programmingTests       ProgrammingTestCase[]
  programmingConfig      ProgrammingQuestionConfig?
  studentAnswers         StudentAnswer[]
  programmingSubmissions ProgrammingSubmission[]

  @@unique([examId, orderIndex])
  @@index([examId])
  @@index([sourceQuestionId])
}

model ExamQuestionOption {
  id             String       @id @default(uuid())
  content        String
  isCorrect      Boolean      @default(false)
  orderIndex     Int
  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id])

  @@unique([examQuestionId, orderIndex])
  @@index([examQuestionId])
}

model ExamAttempt {
  id                     String                  @id @default(uuid())
  attemptNo              Int
  startedAt              DateTime                @default(now())
  attemptEndAt           DateTime
  submittedAt            DateTime?
  remainingSeconds       Int
  lastSavedAt            DateTime?
  endedBy                AttemptEndedBy?
  status                 AttemptStatus           @default(IN_PROGRESS)
  totalScore             Decimal?                @db.Decimal(5, 2)
  autoScore              Decimal?                @db.Decimal(5, 2)
  manualScore            Decimal?                @db.Decimal(5, 2)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  examId                 String
  studentId              String
  exam                   Exam                    @relation(fields: [examId], references: [id])
  student                Student                 @relation("StudentExamAttempts", fields: [studentId], references: [id])
  attemptQuestions       ExamAttemptQuestion[]
  examSession            ExamSession?
  studentAnswers         StudentAnswer[]
  programmingSubmissions ProgrammingSubmission[]
  violations             Violation[]

  @@unique([examId, studentId, attemptNo])
  @@index([studentId])
  @@index([examId])
}

model ExamAttemptQuestion {
  id                String       @id @default(uuid())
  displayOrder      Int
  attemptId         String
  examQuestionId    String
  shuffledOptionIds String[]
  attempt           ExamAttempt  @relation(fields: [attemptId], references: [id])
  examQuestion      ExamQuestion @relation(fields: [examQuestionId], references: [id])

  @@unique([attemptId, examQuestionId])
  @@unique([attemptId, displayOrder])
  @@index([attemptId])
  @@index([examQuestionId])
}

model ExamSession {
  id            String      @id @default(uuid())
  socketId      String?
  ipAddress     String
  deviceInfo    String
  lastHeartbeat DateTime
  isOnline      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  attemptId     String      @unique
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id])
}

model StudentAnswer {
  id                String       @id @default(uuid())
  selectedOptionIds String[]     @default([])
  draftSourceCode   String?
  score             Decimal?     @db.Decimal(5, 2)
  isCorrect         Boolean?
  attemptId         String
  examQuestionId    String
  attempt           ExamAttempt  @relation(fields: [attemptId], references: [id])
  examQuestion      ExamQuestion @relation(fields: [examQuestionId], references: [id])

  @@unique([attemptId, examQuestionId])
  @@index([attemptId])
  @@index([examQuestionId])
}

model ProgrammingSubmission {
  id              String                            @id @default(uuid())
  clientRequestId String                            @unique
  submissionNo    Int
  sourceCode      String
  language        ProgrammingLanguage
  status          ProgrammingSubmissionStatus       @default(PENDING)
  score           Decimal?                          @db.Decimal(5, 2)
  passedTestCases Int                               @default(0)
  totalTestCases  Int                               @default(0)
  executionTimeMs Int?
  memoryUsedKb    Int?
  compilerOutput  String?
  runtimeError    String?
  submittedAt     DateTime                          @default(now())
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  attemptId       String
  examQuestionId  String
  attempt         ExamAttempt                       @relation(fields: [attemptId], references: [id])
  examQuestion    ExamQuestion                      @relation(fields: [examQuestionId], references: [id])
  testResults     ProgrammingSubmissionTestResult[]

  @@unique([attemptId, examQuestionId, submissionNo])
  @@index([attemptId, examQuestionId, submittedAt])
}

model ProgrammingSubmissionTestResult {
  id              String                      @id @default(uuid())
  status          ProgrammingTestResultStatus
  actualOutput    String?
  executionTimeMs Int?
  memoryUsedKb    Int?
  errorMessage    String?
  judge0Token     String?
  submissionId    String
  testCaseId      String
  submission      ProgrammingSubmission       @relation(fields: [submissionId], references: [id])
  testCase        ProgrammingTestCase         @relation(fields: [testCaseId], references: [id])

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
  @@index([testCaseId])
}

model ProgrammingTestCase {
  id                String                            @id @default(uuid())
  input             String
  expectedOutput    String
  weight            Decimal                           @db.Decimal(5, 2)
  isSample          Boolean                           @default(false)
  isHidden          Boolean                           @default(false)
  examQuestionId    String
  examQuestion      ExamQuestion                      @relation(fields: [examQuestionId], references: [id])
  submissionResults ProgrammingSubmissionTestResult[]

  @@index([examQuestionId])
}

model ProgrammingQuestionConfig {
  id             String       @id @default(uuid())
  timeLimitMs    Int          @default(2000)
  memoryLimitKb  Int          @default(262144)
  maxCodeSizeKb  Int          @default(256)
  examQuestionId String       @unique
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id])
}

model Violation {
  id            String        @id @default(uuid())
  violationType ViolationType
  severity      SeverityLevel
  evidenceUrls  Json
  description   String?
  detectedAt    DateTime      @default(now())
  attemptId     String
  attempt       ExamAttempt   @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  userId     String
  ipAddress  String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum TeacherPosition {
  LECTURER
  DEPARTMENT_HEAD
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
}

enum ExamCreationMethod {
  MANUAL
  QUESTION_BANK
  AI_GENERATED
  MIXED
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum QuestionBankItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  PROGRAMMING
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  MANUAL
  AI_GENERATED
  IMPORTED
}

enum AIReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AIGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProgrammingLanguage {
  JAVA
  C
  CPP
}

enum ProgrammingSubmissionStatus {
  PENDING
  COMPILING
  COMPILE_ERROR
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  SYSTEM_ERROR
}

enum ProgrammingTestResultStatus {
  PASSED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  SYSTEM_ERROR
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ExamApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AttemptEndedBy {
  STUDENT
  TIMEOUT
  SYSTEM
}

enum ViolationType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  NO_FACE
  MULTIPLE_FACES
  INACTIVITY
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
}

enum CourseOfferingStatus {
  ACTIVE
  CLOSED
}
