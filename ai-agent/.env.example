# Copy to .env for the private Python service. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key
AI_AGENT_MODEL=gemini-3.5-flash-lite
AI_AGENT_EMBEDDING_MODEL=gemini-embedding-001
AI_AGENT_SHARED_SECRET=same_random_secret_as_backend
# Per process; account for the number of Uvicorn workers/replicas.
AI_AGENT_MAX_CONCURRENT_REQUESTS=4
